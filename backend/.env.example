# Copie este arquivo para .env e ajuste os valores
DB_HOST=localhost
DB_PORT=5432
DB_NAME=asaasdemo
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Origens permitidas para o frontend, separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5173

# URL pública do frontend (usada nos links de retorno do checkout)
FRONTEND_URL=http://localhost:5173

# Asaas (sandbox). A chave de API começa com "$": mantenha sem aspas
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Mesmo token informado no cadastro do webhook no painel do Asaas
ASAAS_WEBHOOK_TOKEN=
